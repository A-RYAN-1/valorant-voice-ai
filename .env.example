# Every setting is optional; the defaults work from a fresh clone.

# Where the local-only folders live (default: next to the code). They hold your extracted game audio
# (data/raw/<agent>/*.wav), cleaned clips and manifests, and model weights. Never commit them.
VV_DATA_DIR=./data
VV_MODEL_DIR=./models
VV_OUTPUT_DIR=./outputs

# Folder of a fine-tuned XTTS-v2 checkpoint (config.json, model.pth, vocab.json).
# Leave empty to use the base XTTS-v2 model.
VV_CHECKPOINT_DIR=

# "cuda" or "cpu". Empty picks cuda when a GPU is available.
VV_DEVICE=

# API limits: longest text in characters, and requests per minute per client.
VV_MAX_CHARS=300
VV_RATE_LIMIT_PER_MINUTE=20

# Seed for the train/val/test split. Changing it moves lines between splits.
VV_SPLIT_SEED=13
